# Variables para Railway (copiar en el dashboard o en Variables)

APP_NAME="La Chilinga"
APP_ENV=production
APP_DEBUG=false
APP_URL=https://sistemadegestion-production-bdf3.up.railway.app
# Generalo con: php artisan key:generate --show (nunca lo commitees)
APP_KEY=
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Base de datos (valores del plugin MySQL / Conurbania)
DB_CONNECTION=mysql
DB_HOST=
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=root
DB_PASSWORD=

# Sesión y cookies en HTTPS (obligatorio en producción)
# APP_URL tiene que ser la URL pública exacta (ej. https://admin-chilingo.up.railway.app)
SESSION_DRIVER=database
SESSION_COOKIE=chilinga-session
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

# Cache y colas (mismo driver que DB si no tenés Redis)
CACHE_STORE=database
QUEUE_CONNECTION=database

# Kit de percusión: regenerar WAV al arrancar (ffmpeg en la imagen). 0 = usar los del repo.
# PERC_KIT_REBUILD=1

# WhatsApp (Twilio)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# TWILIO_STATUS_CALLBACK_URL=https://admin-chilingo.up.railway.app/webhooks/twilio/whatsapp-status

# Plataforma multirrol / API / app móvil
# SANCTUM_TOKEN_MINUTOS=43200
# PROGRAMA_EDICION_PUBLICA=true
# EXPO_PUSH_ENABLED=false
# EXPO_ACCESS_TOKEN=

# ── Infra (ver docs/DEPLOY_RAILWAY.md) ─────────────────────────────────────────────────────
# Volumen persistente montado en /data/storage (comprobantes, backups, archivos).
PERSISTENT_STORAGE_PATH=/data/storage
# Railway monta los volúmenes como root: con esto start.sh corrige permisos y baja a www-data.
RAILWAY_RUN_UID=0

# Proceso del servicio: web (default), scheduler o worker. Lo fijan también railway*.toml.
# PROCESO=web
# Scheduler dentro del web: 1 hasta crear el servicio "scheduler"; después 0 en el web.
SCHEDULER_EN_WEB=1
# Hilos PHP de FrankenPHP (requests simultáneos). Subilo si el plan tiene más RAM.
# PHP_THREADS=8

# Logs: a stderr (Railway los muestra). info en producción.
LOG_CHANNEL=stack
LOG_STACK=stderr
LOG_LEVEL=info

# Errores en Sentry (opcional; vacío = apagado). Nunca envía datos personales.
SENTRY_LARAVEL_DSN=
# SENTRY_TRACES_SAMPLE_RATE=0

# Almacenamiento S3 / Cloudflare R2 (opcional)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# AWS_BUCKET=chilinga-respaldos
# AWS_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
# AWS_USE_PATH_STYLE_ENDPOINT=true

# Copia cifrada del backup diario fuera de Railway (requiere el bloque S3/R2)
# RESPALDO_DISCO_EXTERNO=s3
# RESPALDO_CLAVE=            # 32+ caracteres al azar; guardala también FUERA de Railway (sin ella no se restaura)
# RESPALDO_EXTERNO_CONSERVAR=30

# Archivos de usuarios compartidos entre servicios (audio para transcribir, etc.): local o s3
# ARCHIVOS_DISCO=local

# Heartbeats (Healthchecks.io / Better Stack): URL de ping, vacío = apagado
# HEARTBEAT_URL_SCHEDULER=
# HEARTBEAT_SCHEDULER_MINUTOS=10
# HEARTBEAT_URL_RESPALDO=
