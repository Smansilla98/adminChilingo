APP_NAME="La Chilinga"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=America/Argentina/Buenos_Aires

# Producción (Railway): usar APP_ENV=production, APP_DEBUG=false y tu APP_URL
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://sistemadegestion-production-xxxx.up.railway.app
# SESSION_SECURE_COOKIE=true

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Base de datos MySQL (local)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=chilinga_admin
DB_USERNAME=root
DB_PASSWORD=

# Railway: definir DB_HOST, DB_DATABASE, DB_USERNAME, DB_PASSWORD en el dashboard
# (o usar las variables del plugin MySQL: MYSQLHOST, MYSQLDATABASE, MYSQLUSER, MYSQLPASSWORD)

# Local: file. Producción (Railway): database (file se borra en cada deploy → 419)
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_COOKIE=chilinga-session

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

# WhatsApp (Twilio) - recordatorios y notificaciones
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=+14155238886
# URL pública del status callback (producción/staging). Localhost no es alcanzable por Twilio.
# TWILIO_STATUS_CALLBACK_URL=https://admin-chilingo.up.railway.app/webhooks/twilio/whatsapp-status

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Registro público (por defecto OFF: altas solo vía admin)
ALLOW_PUBLIC_REGISTER=false

# Disco persistente para comprobantes/PDFs (Railway: montá un volumen, ej. /data/storage)
# PERSISTENT_STORAGE_PATH=/data/storage
# Videos de biblioteca: en local subí upload_max_filesize y post_max_size a 100M en php.ini
# (en Railway lo setea docker/php/uploads.ini)

# Kit de percusión al arrancar (start.sh). 0 = no correr ffmpeg, usar WAV del repo.
# PERC_KIT_REBUILD=1
# CHILINGA_KIT_SRC=scripts/chilinga-kit-src

# --- Plataforma multirrol / API / app móvil ---
# Vencimiento de los tokens de la app (minutos). Se rotan con /api/v1/auth/refresh.
SANCTUM_TOKEN_MINUTOS=43200
# Edición colaborativa de partituras sin login (comportamiento histórico). false = requiere permiso.
PROGRAMA_EDICION_PUBLICA=true
# Push a la app (Expo). Desactivado por defecto: no genera tráfico externo.
EXPO_PUSH_ENABLED=false
EXPO_ACCESS_TOKEN=
